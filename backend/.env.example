# ==========================================
# Track Automotive Automation - Backend Config
# ==========================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key-32chars
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL with automatic SQLite fallback)
# Set USE_SQLITE=True to force SQLite for fast local development without PostgreSQL
USE_SQLITE=False
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackautomotive
DB_NAME=trackautomotive
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Settings
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# AI Chatbot Configuration
# Supported providers: gemini, openai, groq, or mock
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-1.5-flash
