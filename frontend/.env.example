# Track Automotive Automation - Frontend Environment Variables
# Public API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=track-automotive.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=track-automotive
VITE_FIREBASE_STORAGE_BUCKET=track-automotive.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Legacy Google OAuth Client ID (optional fallback)
VITE_GOOGLE_CLIENT_ID=
